rules_version = '2';

/**
 * Ravika Firestore schema (aligned with client services)
 *
 * users/{uid}
 *   phoneE164, phoneHash, username, displayName, bio, avatarUrl, gender,
 *   dateOfBirth, notificationPreferences, isAdmin, lastActiveAt,
 *   deviceTokens[], createdAt, updatedAt
 *   — client may write own profile fields (not isAdmin / counters)
 *
 * usernames/{username} → { userId }
 * phoneHashes/{hash} → { uid }          — server-only uniqueness index
 *
 * connections/{connectionId}
 *   userIds: [uidA, uidB] (sorted), participants: { [uid]: { relationshipType,
 *   pinned, pinOrder, ... } }, status, createdAt, updatedAt, acceptedAt,
 *   lastInteractionAt, interactionCount, unreadCounts, missYouCount
 *   — participants read; pin fields writable by participant (max 2 pins enforced client+rules)
 *
 * connectionRequests/{id}
 *   fromUserId, toUserId, proposedRelationshipType, message, status,
 *   createdAt, updatedAt, respondedAt, connectionId?
 *   — sender create; receiver/sender update status; participants read
 *
 * interactions/{id}                     — client create (participant) or Functions
 * dailyStats/{connectionId_yyyy-mm-dd}  — server-only (also optional uid_day keys)
 * weeklyStats/{connectionId_weekKey}    — server-only
 * monthlyStats/{connectionId_yyyy-mm}   — server-only
 *
 * adminSettings/global                  — server-only writes; authenticated read
 * rateLimitSettings/global              — server-only (mirror)
 * notificationSettings/global           — server-only (mirror)
 *
 * otpSessions/{id}                      — admin SDK only
 * rateLimitBuckets/{uid|otp_hash}       — admin SDK only
 * notificationGroups/{recipient_sender_reaction} — admin SDK only
 *
 * userDevices/{uid}/tokens/{tokenId}    — owner read/write
 * customReactions/{uid}/items/{id}      — owner read/write
 * milestones/{connectionId|uid}/items/{id} — participants/owner read; server write
 *
 * chats/{connectionId}
 *   userIds, lastMessage, lastMessageAt, lastFromUserId, unreadCounts, updatedAt
 * chats/{connectionId}/messages/{messageId}
 *   fromUserId, text, createdAt, status (sent|delivered|read), deliveredAt?, readAt?
 */
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isAdminUser() {
      return signedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && userDoc(request.auth.uid).isAdmin == true)
      );
    }

    function connectionData(connectionId) {
      return get(/databases/$(database)/documents/connections/$(connectionId)).data;
    }

    function isConnectionParticipant(connectionId) {
      return signedIn()
        && connectionId is string
        && exists(/databases/$(database)/documents/connections/$(connectionId))
        && request.auth.uid in connectionData(connectionId).userIds;
    }

    // ——— users ———
    match /users/{uid} {
      // Own full read; others get discovery-safe fields only via queries
      // (rules cannot strip fields — clients must avoid selecting secrets).
      // Phone fields are readable by authenticated users for discovery fallbacks;
      // prefer phoneHashes + matchContacts callable in production.
      allow read: if signedIn();

      allow create: if isSelf(uid)
        && request.resource.data.isAdmin == false
        && request.resource.data.keys().hasAll([
          'phoneE164', 'phoneHash', 'username', 'displayName',
          'notificationPreferences', 'createdAt', 'updatedAt'
        ]);

      allow update: if isSelf(uid)
        && request.resource.data.isAdmin == resource.data.isAdmin
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'displayName', 'bio', 'avatarUrl', 'gender', 'dateOfBirth',
              'notificationPreferences', 'username', 'updatedAt', 'lastActiveAt',
              'deviceTokens'
            ]);

      allow delete: if false;
    }

    // ——— usernames ———
    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update, delete: if false;
    }

    // ——— phoneHashes (server-only) ———
    match /phoneHashes/{hash} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ——— connections ———
    match /connections/{connectionId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.userIds;

      // Accept flow creates the ACTIVE connection from the client.
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.userIds
        && request.resource.data.userIds.size() == 2
        && request.resource.data.status == 'active';

      // Clients may tweak pin fields, shared feelings, or soft interaction metadata.
      allow update: if signedIn()
        && request.auth.uid in resource.data.userIds
        && request.resource.data.userIds == resource.data.userIds
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'participants', 'updatedAt', 'sharedFeelings', 'feelingOverrides',
              'lastInteractionAt', 'interactionCount', 'unreadCounts', 'missYouCount'
            ]);

      allow delete: if false;
    }

    // ——— connectionRequests ———
    match /connectionRequests/{requestId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.fromUserId
            || request.auth.uid == resource.data.toUserId);

      allow create: if signedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId is string
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if signedIn()
        && (request.auth.uid == resource.data.toUserId
            || request.auth.uid == resource.data.fromUserId)
        && resource.data.status == 'pending'
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId;

      allow delete: if false;
    }

    // ——— interactions ———
    // Prefer Cloud Function `sendInteraction` on Blaze; client create allowed
    // on Spark so sparks still work without Functions.
    match /interactions/{interactionId} {
      allow read: if signedIn()
        && isConnectionParticipant(resource.data.connectionId);

      allow create: if signedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId is string
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.connectionId is string
        && isConnectionParticipant(request.resource.data.connectionId)
        && request.resource.data.keys().hasAll([
          'connectionId', 'fromUserId', 'toUserId', 'reactionType',
          'emoji', 'title', 'message', 'createdAt', 'dayKey'
        ]);

      allow update, delete: if false;
    }

    // ——— stats (server-only writes; participants read) ———
    match /dailyStats/{statId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /weeklyStats/{statId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /monthlyStats/{statId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ——— admin / rate / notification settings ———
    match /adminSettings/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /rateLimitSettings/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /notificationSettings/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ——— OTP / rate buckets / notification groups (admin SDK only) ———
    match /otpSessions/{id} {
      allow read, write: if false;
    }
    match /rateLimitBuckets/{id} {
      allow read, write: if false;
    }
    match /notificationGroups/{id} {
      allow read, write: if false;
    }

    // ——— devices ———
    match /userDevices/{uid} {
      allow read: if isSelf(uid);
      match /tokens/{tokenId} {
        allow read, write: if isSelf(uid);
      }
    }

    // ——— custom reactions ———
    match /customReactions/{uid} {
      allow read: if signedIn();
      match /items/{itemId} {
        allow read: if signedIn();
        allow create, update: if isSelf(uid)
          && request.resource.data.ownerUserId == uid;
        allow delete: if isSelf(uid);
      }
    }

    // ——— milestones ———
    match /milestones/{parentId} {
      allow read: if signedIn();
      match /items/{itemId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // ——— chats (WhatsApp-style 1:1) ———
    match /chats/{connectionId} {
      allow read: if isConnectionParticipant(connectionId);

      // Participants may create/merge thread metadata (last message, unread, etc.).
      allow create, update: if isConnectionParticipant(connectionId)
        && request.resource.data.userIds is list
        && request.resource.data.userIds.size() == 2
        && request.auth.uid in request.resource.data.userIds;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConnectionParticipant(connectionId);

        allow create: if isConnectionParticipant(connectionId)
          && request.resource.data.fromUserId == request.auth.uid
          && request.resource.data.connectionId == connectionId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.keys().hasAll([
            'connectionId', 'fromUserId', 'text', 'createdAt', 'status'
          ])
          && request.resource.data.status == 'sent';

        // Recipient may advance status: sent → delivered → read
        allow update: if isConnectionParticipant(connectionId)
          && resource.data.fromUserId != request.auth.uid
          && request.resource.data.fromUserId == resource.data.fromUserId
          && request.resource.data.text == resource.data.text
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'deliveredAt', 'readAt']);

        allow delete: if false;
      }
    }
  }
}
